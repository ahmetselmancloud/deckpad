<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Trackpad Outer Body (Centered at x=54, y=54, 56x50dp) -->
    <path
        android:pathData="M34,28 h40 a8,8 0 0 1 8,8 v34 a8,8 0 0 1 -8,8 h-40 a8,8 0 0 1 -8,-8 v-34 a8,8 0 0 1 8,-8 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="26"
                android:startY="28"
                android:endX="82"
                android:endY="78"
                android:type="linear">
                <item android:color="#363152" android:offset="0.0" />
                <item android:color="#1A182E" android:offset="1.0" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="26"
                android:startY="28"
                android:endX="82"
                android:endY="78"
                android:type="linear">
                <item android:color="#B99BFF" android:offset="0.0" />
                <item android:color="#6D4AFF" android:offset="0.6" />
                <item android:color="#4B2BE0" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Trackpad Clicker Divider Lines -->
    <path
        android:pathData="M26,64 h56"
        android:strokeColor="#3F3960"
        android:strokeWidth="1.5" />
    <path
        android:pathData="M54,64 v14"
        android:strokeColor="#3F3960"
        android:strokeWidth="1.5" />

    <!-- Multi-touch Radiating Wave 2 (Outer) -->
    <path
        android:pathData="M37,42 a18,16 0 0 1 34,0"
        android:strokeColor="#7452FF"
        android:strokeWidth="2.2"
        android:strokeLineCap="round" />

    <!-- Multi-touch Radiating Wave 1 (Inner) -->
    <path
        android:pathData="M43,44 a11,9 0 0 1 22,0"
        android:strokeColor="#A88EFF"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- Center Primary Touch Node -->
    <path
        android:pathData="M54,47m-3.5,0a3.5,3.5 0 1,1 7,0a3.5,3.5 0 1,1 -7,0"
        android:fillColor="#FFFFFF" />

    <!-- Left & Right Multi-touch Finger Dots -->
    <path
        android:pathData="M44,52m-2,0a2,2 0 1,1 4,0a2,2 0 1,1 -4,0"
        android:fillColor="#BFA8FF" />
    <path
        android:pathData="M64,52m-2,0a2,2 0 1,1 4,0a2,2 0 1,1 -4,0"
        android:fillColor="#BFA8FF" />

    <!-- Bottom Left/Right Click Indicators -->
    <path
        android:pathData="M38,71 h4"
        android:strokeColor="#655C8E"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />
    <path
        android:pathData="M66,71 h4"
        android:strokeColor="#655C8E"
        android:strokeWidth="1.8"
        android:strokeLineCap="round" />

</vector>